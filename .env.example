# Required for real AI-generated interventions. Without it PATCHRUN runs in
# clearly labelled DETERMINISTIC FALLBACK mode (everything else still works).
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5-5.
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional. Per-request timeout for the AI call before falling back (ms). Default 30000.
# PATCHRUN_AI_TIMEOUT_MS=30000
