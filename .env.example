# Set ONE of these for real AI-generated interventions. Anthropic is preferred
# when both are present. With neither, PATCHRUN runs in clearly labelled
# DETERMINISTIC FALLBACK mode (everything else still works).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides.
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_MODEL=gpt-6.1-sol

# Optional. Per-request timeout for the AI call before falling back (ms). Default 30000.
# PATCHRUN_AI_TIMEOUT_MS=30000
